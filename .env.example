# 用法：复制本文件为 .env，再把下面的占位值换成自己的真 key
#   cp .env.example .env      （Windows: copy .env.example .env）
# .env 已被 .gitignore 排除，永远不会提交；本文件里全部都是占位符，不是真密钥

# ① 生成模型（DeepSeek）：只负责最后"写答案"
# 占位符，不是真 key
DEEPSEEK_API_KEY=your_deepseek_key_here
# 官方当前推荐不带 /v1；S2 项目用的 https://api.deepseek.com/v1 是兼容写法，目前也能用
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名写在代码里（不是本文件）：官方推荐 deepseek-flash；deepseek-chat 已于 2026/07/24 弃用

# ② 向量化模型（硅基流动 BAAI/bge-m3）：只负责"把文字变向量"
#    DeepSeek 没有 /embeddings 端点，所以必须换一个服务，两把 key 不能混用
# 第二把钥匙，和上面那把来自不同平台，绝不能混用
SILICONFLOW_API_KEY=your_siliconflow_key_here
# 硅基流动是标准 OpenAI 兼容网关，接口都挂在 /v1 下，**必须带 /v1**，去掉会 404
# 国内站用 .cn；国际站是 .com，两个站点的 key 不通用，按你申请 key 的站点选
EMBED_BASE_URL=https://api.siliconflow.cn/v1
# 1024 维，中文友好；模型名大小写要完全一致
EMBED_MODEL=BAAI/bge-m3

# 备注：.env 若写行内注释，# 前要留空格；本样例统一用独立注释行，避免解析歧义
